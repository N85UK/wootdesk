<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- No tracking. WootDesk contains no advertising, no analytics SDK, no
	     third-party package of any kind, and contacts no host the user has
	     not configured. -->
	<key>NSPrivacyTracking</key>
	<false/>
	<key>NSPrivacyTrackingDomains</key>
	<array/>

	<!-- Declared because a user who enables remote notifications enrols with
	     a WootDesk Push Gateway, which stores an APNs device token and
	     routing identifiers for up to 90 days. That is longer than servicing
	     the request in real time, so it is collection under Apple's
	     definition even though the app ships with no gateway address and the
	     feature is off until the user supplies one. -->
	<key>NSPrivacyCollectedDataTypes</key>
	<array>
		<dict>
			<!-- The APNs device token and the app's own device UUID. -->
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeDeviceID</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<true/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>
		<dict>
			<!-- The Chatwoot agent user ID and the saved profile UUID. The
			     agent ID is what lets the gateway send a conversation to the
			     agent it is assigned to rather than to every device on the
			     account. -->
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeUserID</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<true/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>
	</array>

	<!-- The app uses no required-reason API. Verified by search: no
	     UserDefaults, no file timestamp APIs, no disk space or system uptime
	     APIs. -->
	<key>NSPrivacyAccessedAPITypes</key>
	<array/>
</dict>
</plist>
