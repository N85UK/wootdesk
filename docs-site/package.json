{
  "name": "wootdesk-docs",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Public WootDesk documentation published at https://docs.n85.app",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "node scripts/build-retirement.mjs",
    "build:legacy": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "verify:boundary": "node scripts/check-content-boundary.mjs",
    "verify:links": "node scripts/check-internal-links.mjs",
    "verify": "npm run test:retirement && npm run verify:boundary && npm run verify:retirement",
    "test:retirement": "node --test tests/retirement.test.mjs && python3 -B -m unittest discover -s tests -p test_retirement_probe.py",
    "verify:retirement": "node scripts/verify-retirement.mjs",
    "verify:a11y:retirement": "playwright test --config playwright.retirement.config.mjs",
    "verify:a11y": "playwright test",
    "verify:external": "node scripts/check-external-links.mjs"
  },
  "dependencies": {
    "@astrojs/starlight": "0.42.0",
    "astro": "7.2.10"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.62.1",
    "typescript": "6.0.3",
    "wrangler": "^4.131.0"
  }
}
