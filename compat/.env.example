# Copy to compat/.env and fill in. compat/.env is gitignored and must never be
# committed.
#
# Pin an exact Chatwoot release. The supported-version matrix in
# docs/CHATWOOT_COMPATIBILITY.md records the exact tag used for each run, so a
# floating tag such as "latest" is not acceptable as evidence.
CHATWOOT_VERSION=v4.9.0

# Generated by script/compat_env.sh when it creates compat/.env.
SECRET_KEY_BASE=
POSTGRES_PASSWORD=
REDIS_PASSWORD=

# Wiring for the Chatwoot containers.
POSTGRES_HOST=postgres
POSTGRES_USERNAME=chatwoot
POSTGRES_DATABASE=chatwoot
REDIS_URL=redis://:${REDIS_PASSWORD}@redis:6379

# The HTTPS address WootDesk connects to.
FRONTEND_URL=https://wootdesk-compat.localhost:8443
COMPAT_HTTPS_PORT=8443

# This server must never contact a real person or production system.
MAILER_SENDER_EMAIL=compatibility@example.invalid
SMTP_ADDRESS=
SMTP_PORT=
ENABLE_ACCOUNT_SIGNUP=false
ACTIVE_STORAGE_SERVICE=local
RAILS_LOG_TO_STDOUT=true
LOG_LEVEL=warn
