# Copy this file into the secret configuration mechanism used by the host.
# Placeholder values are deliberately invalid. Never commit generated values.
NODE_ENV=production
HOST=127.0.0.1
PORT=8080
ALLOW_INSECURE_LOCAL_TEST=false

DATA_FILE=/data/wootdesk-push-gateway.json
DATA_ENCRYPTION_KEY=<base64url-encoded-32-byte-key>
DEVICE_API_TOKEN=<base64url-encoded-secret-of-at-least-32-bytes>
WEBHOOK_ROUTE_SECRET=<base64url-encoded-secret-of-at-least-32-bytes>
CHATWOOT_WEBHOOK_SIGNING_SECRET=
CHATWOOT_SIGNATURE_TOLERANCE_SECONDS=300

APNS_TEAM_ID=<apple-team-id>
APNS_KEY_ID=<apns-key-id>
APNS_PRIVATE_KEY_FILE=/run/secrets/apns-private-key.p8
APNS_BUNDLE_ID=dev.n85.wootdesk

MAX_BODY_BYTES=32768
REQUEST_TIMEOUT_MS=10000
RATE_LIMIT_WINDOW_MS=60000
DEVICE_RATE_LIMIT=30
WEBHOOK_RATE_LIMIT=300
IDEMPOTENCY_TTL_SECONDS=86400
REGISTRATION_TTL_DAYS=90
MAX_REGISTRATIONS_PER_EVENT=500
SHUTDOWN_GRACE_MS=10000
