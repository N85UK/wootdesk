# Copy this file into the secret configuration mechanism used by the host.
# Placeholder values are deliberately invalid. Never commit generated values.
NODE_ENV=production
HOST=127.0.0.1
PORT=8080
ALLOW_INSECURE_LOCAL_TEST=false

DATA_FILE=/data/wootdesk-push-gateway.json
DATA_ENCRYPTION_KEY=<base64url-encoded-32-byte-key>
DEVICE_API_TOKEN=<base64url-encoded-secret-of-at-least-32-bytes>
# One Chatwoot deployment. These two are the whole configuration when the
# gateway serves a single Chatwoot, which is the usual case, and they become a
# deployment called "default".
WEBHOOK_ROUTE_SECRET=<base64url-encoded-secret-of-at-least-32-bytes>
CHATWOOT_WEBHOOK_SIGNING_SECRET=
CHATWOOT_SIGNATURE_TOLERANCE_SECONDS=300

# More than one Chatwoot deployment (N85-64).
#
# An account number is unique only within one Chatwoot, so a gateway serving
# two deployments cannot tell an event for account 1 on one from account 1 on
# the other. The route the request arrives on is the only discriminator, so
# each deployment needs its OWN route secret. Sharing one recreates exactly
# the defect this exists to prevent, and the gateway refuses to start if two
# deployments share a route secret or an address.
#
# Setting CHATWOOT_DEPLOYMENTS replaces WEBHOOK_ROUTE_SECRET above. The
# address is required: enrolment uses it to work out which deployment a server
# profile belongs to.
#
# CHATWOOT_DEPLOYMENTS=production,review
# CHATWOOT_DEPLOYMENT_PRODUCTION_BASE_URL=https://chat.example.com
# CHATWOOT_DEPLOYMENT_PRODUCTION_ROUTE_SECRET=<base64url-encoded-secret-of-at-least-32-bytes>
# CHATWOOT_DEPLOYMENT_PRODUCTION_SIGNING_SECRET=<secret-issued-by-that-chatwoot>
# CHATWOOT_DEPLOYMENT_REVIEW_BASE_URL=https://review.example.com
# CHATWOOT_DEPLOYMENT_REVIEW_ROUTE_SECRET=<a-different-base64url-secret>
# CHATWOOT_DEPLOYMENT_REVIEW_SIGNING_SECRET=<secret-issued-by-that-chatwoot>

APNS_TEAM_ID=<apple-team-id>
APNS_KEY_ID=<apns-key-id>
APNS_PRIVATE_KEY_FILE=/run/secrets/apns-private-key.p8
APNS_BUNDLE_ID=dev.n85.wootdesk

MAX_BODY_BYTES=32768
REQUEST_TIMEOUT_MS=10000
RATE_LIMIT_WINDOW_MS=60000
DEVICE_RATE_LIMIT=30
WEBHOOK_RATE_LIMIT=300
IDEMPOTENCY_TTL_SECONDS=86400
REGISTRATION_TTL_DAYS=90
MAX_REGISTRATIONS_PER_EVENT=500
SHUTDOWN_GRACE_MS=10000
